# Base URL API. Kosongkan agar memakai proxy dev Vite ke backend lokal (localhost:8000).
VITE_API_BASE_URL=

# Proxy dev server (dipakai vite.config.ts) bila backend berjalan di alamat lain.
# VITE_API_PROXY_TARGET=http://localhost:8000

# Mode demo tanpa backend: aktifkan "1" untuk memakai data contoh.
VITE_APP_MOCK=1
